# Copy this file, name the copy ".env", and fill in your own details.

# The SEC requires every program that downloads filings to say who is asking.
# Format: your name, then your email. Example:  Jane Doe jane@andrew.cmu.edu
SEC_USER_AGENT=Your Name your_email@example.com

# Your Claude API key (starts with sk-ant-). Needed for step 3 and the app's
# "Run the agent" button. START_HERE.md Part 6 explains how to get one.
ANTHROPIC_API_KEY=

# Which Claude model reads the releases. Leave as is unless you want to change it.
CLAUDE_MODEL=claude-sonnet-5-5
